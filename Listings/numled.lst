 188   2              out_current = rt.out_current;
 189   2              if(out_current <= 10){/* 0.1A */
 190   3                  soc = rt.soc / 10;
 191   3                  soc_bai = soc / 100;
 192   3                  soc_shi = (soc / 10) % 10;
 193   3                  soc_ge = soc % 10;
 194   3                  DG_Display(soc_bai, soc_shi, soc_ge);
 195   3                  DG_LED(2);
 196   3              }else{/* charge */
 197   3                  soc = rt.soc / 10;
 198   3                  soc_bai = soc / 100;
 199   3                  soc_shi = (soc / 10) % 10;
 200   3                  soc_ge = soc % 10;
 201   3                  DG_Display(soc_bai, soc_shi, soc_ge);
 202   3                  DG_LED(1);
 203   3              }
 204   2      //        Relay = Relay_ON;
 205   2          }else{/* fault */
 206   2              for (idx = 0U; idx < 16U; idx++) {
 207   3                  if ((terr_flag.raw & ((unsigned short int)1U << idx)) != 0U) {
 208   4                      fault_code = idx;
 209   4                  }
 210   3              }
 211   2              DG_Display(0, 10, fault_code);
 212   2              DG_LED(3);
 213   2          }
 214   1      }


